# Copie para .env (NUNCA comite o .env). Nao use prefixo VITE aqui: este e o back-end.
PORT=5000
# Origens permitidas no CORS (separe por virgula): front local e a URL da Vercel
CORS_ORIGINS=http://localhost:5173,https://SEU-PROJETO.vercel.app
# Telegram: token do @BotFather. O segredo do webhook voce inventa (letras e numeros)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# 1 = tambem manda a resposta em audio MP3 (precisa de gTTS e internet)
TELEGRAM_VOZ=0
